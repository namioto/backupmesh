<Window x:Class="BackupMesh.Storage.App.RenameSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Source Agent" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="RenameSourceWindow">
    <StackPanel Margin="20">
        <TextBlock Text="Display name" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="This only changes what the tray shows you; the Source keeps reporting its own name." TextWrapping="Wrap" Foreground="#607086" Margin="0,0,0,10"/>
        <TextBox x:Name="DisplayNameText" Margin="0,0,0,16" AutomationProperties.AutomationId="RenameSourceTextBox"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="OnCancelClick" IsCancel="True" Margin="0,0,10,0" Padding="10,4" AutomationProperties.AutomationId="RenameSourceCancelButton"/>
            <Button Content="Save" Click="OnSaveClick" IsDefault="True" Padding="10,4" AutomationProperties.AutomationId="RenameSourceSaveButton"/>
        </StackPanel>
    </StackPanel>
</Window>
