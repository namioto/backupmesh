<Window x:Class="BackupMesh.Storage.App.ConnectAgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BackupMesh.Storage.App"
        Title="{local:Loc UX_9e01524ae4}" Width="760" MinWidth="650" Height="690" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI" FontSize="12" Foreground="#172B4D" Icon="Assets/backupmesh-tray.ico"
        AutomationProperties.AutomationId="ConnectAgentWindow">
    <Grid Margin="32,26,32,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{local:Loc UX_2bbfca2dc3}" Style="{StaticResource PageHeadingStyle}" FontSize="27"/>
            <TextBlock Text="{local:Loc UX_c67a8ffa47}" Foreground="#60718D" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="#E3F8F5" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="1" FontSize="17" FontWeight="Bold" Foreground="#007F78" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{local:Loc UX_836e38d8f0}" Style="{StaticResource CardHeadingStyle}" Margin="0,0,0,7" AutomationProperties.AutomationId="ConnectAgentStep1"/>
                            <TextBlock Text="{local:Loc UX_8e9e864182}" Foreground="#526987" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="#E3F8F5" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="2" FontSize="17" FontWeight="Bold" Foreground="#007F78" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{local:Loc UX_23100a8001}" Style="{StaticResource CardHeadingStyle}" Margin="0,0,0,7" AutomationProperties.AutomationId="ConnectAgentStep2"/>
                            <TextBlock Text="{local:Loc UX_1fde4c58eb}" Foreground="#526987" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="#E3F8F5" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="3" FontSize="17" FontWeight="Bold" Foreground="#007F78" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{local:Loc UX_d84721e4a8}" Style="{StaticResource CardHeadingStyle}" Margin="0,0,0,7" AutomationProperties.AutomationId="ConnectAgentStep3"/>
                            <TextBlock Text="{local:Loc UX_4a57ca4489}" Foreground="#526987" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Margin="4,2,0,0" Foreground="#126AA3"><Hyperlink NavigateUri="https://github.com/namioto/backupmesh/blob/main/docs/INSTALLATION.ko.md" RequestNavigate="OnInstallationGuideClick"><Run Text="{local:Loc UX_dc80ac198e}"/></Hyperlink></TextBlock>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" Content="{local:Loc UX_468266d639}" Click="OnCloseClick" IsDefault="True" IsCancel="True" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Margin="0,18,0,0" Padding="28,10" AutomationProperties.AutomationId="ConnectAgentCloseButton"/>
    </Grid>
</Window>
