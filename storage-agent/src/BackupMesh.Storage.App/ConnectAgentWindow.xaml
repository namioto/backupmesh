<Window x:Class="BackupMesh.Storage.App.ConnectAgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BackupMesh.Storage.App"
        Title="새 에이전트 연결" Width="760" MinWidth="650" Height="690" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI" FontSize="15" Foreground="#172B4D" Icon="Assets/backupmesh-tray.ico"
        AutomationProperties.AutomationId="ConnectAgentWindow">
    <Grid Margin="32,26,32,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="다른 컴퓨터도 백업할 수 있습니다" Style="{StaticResource PageHeadingStyle}" FontSize="30"/>
            <TextBlock Text="원격 컴퓨터에 에이전트를 설치하면 이 PC의 저장장치로 백업을 받을 수 있습니다." Foreground="#60718D" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="#E3F8F5" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="1" FontSize="17" FontWeight="Bold" Foreground="#007F78" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="원격 컴퓨터에 설치" Style="{StaticResource CardHeadingStyle}" Margin="0,0,0,7" AutomationProperties.AutomationId="ConnectAgentStep1"/>
                            <TextBlock Text="백업할 Windows 또는 Ubuntu 컴퓨터에 BackupMesh 원격 에이전트를 설치하세요. Ubuntu는 설치 마법사에서, Windows는 에이전트 설정에서 백업 폴더를 지정합니다." Foreground="#526987" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="#E3F8F5" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="2" FontSize="17" FontWeight="Bold" Foreground="#007F78" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="발견된 컴퓨터에서 연결 요청" Style="{StaticResource CardHeadingStyle}" Margin="0,0,0,7" AutomationProperties.AutomationId="ConnectAgentStep2"/>
                            <TextBlock Text="두 컴퓨터를 같은 네트워크에 연결하세요. 이 창을 닫으면 원격 에이전트 목록에 발견된 컴퓨터가 자동으로 나타납니다. 해당 행의 '연결 요청'을 누르세요." Foreground="#526987" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="#E3F8F5" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="3" FontSize="17" FontWeight="Bold" Foreground="#007F78" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="번호 확인 후 백업 규칙 추가" Style="{StaticResource CardHeadingStyle}" Margin="0,0,0,7" AutomationProperties.AutomationId="ConnectAgentStep3"/>
                            <TextBlock Text="양쪽 컴퓨터의 6자리 번호가 같으면 원격 컴퓨터에서 승인하세요. 연결되면 '백업 규칙 → 새 규칙'에서 원격 폴더와 저장 위치를 선택합니다." Foreground="#526987" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Margin="4,2,0,0" Foreground="#126AA3"><Hyperlink NavigateUri="https://github.com/namioto/backupmesh/blob/main/docs/INSTALLATION.ko.md" RequestNavigate="OnInstallationGuideClick">Windows·Ubuntu 설치 방법 자세히 보기</Hyperlink></TextBlock>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" Content="확인" Click="OnCloseClick" IsDefault="True" IsCancel="True" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Margin="0,18,0,0" Padding="28,10" AutomationProperties.AutomationId="ConnectAgentCloseButton"/>
    </Grid>
</Window>
