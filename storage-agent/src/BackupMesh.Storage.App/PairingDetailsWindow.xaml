<Window x:Class="BackupMesh.Storage.App.PairingDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair Source Agent" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="One-time pairing details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="Enter these in the Source Agent pairing screen. The code expires in 10 minutes and works once." TextWrapping="Wrap" Foreground="#607086" Margin="0,0,0,14"/>

        <TextBlock Text="Storage endpoint" Foreground="#607086"/>
        <TextBox x:Name="EndpointText" IsReadOnly="True" Margin="0,2,0,10"/>

        <TextBlock Text="Pairing code" Foreground="#607086"/>
        <TextBox x:Name="CodeText" IsReadOnly="True" FontFamily="Consolas" Margin="0,2,0,10"/>

        <TextBlock Text="Certificate SHA-256 fingerprint" Foreground="#607086"/>
        <TextBox x:Name="FingerprintText" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2,0,10"/>

        <TextBlock Text="Expires" Foreground="#607086"/>
        <TextBox x:Name="ExpiresText" IsReadOnly="True" Margin="0,2,0,14"/>

        <Border Background="#FFF6E5" BorderBrush="#E4C078" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
            <TextBlock TextWrapping="Wrap" Foreground="#7A5B12" Text="Your clipboard can be read by other processes on this PC. Only copy this pairing code when you are ready to paste it into the Source Agent, and avoid pasting it anywhere else."/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="CopyStatus" Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="Copy to clipboard" Click="OnCopyClick" Margin="0,0,10,0" Padding="10,4"/>
            <Button Content="Close" Click="OnCloseClick" IsCancel="True" Padding="10,4"/>
        </StackPanel>
    </StackPanel>
</Window>
