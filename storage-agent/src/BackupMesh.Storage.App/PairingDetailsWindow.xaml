<Window x:Class="BackupMesh.Storage.App.PairingDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BackupMesh.Storage.App"
        Title="{local:Loc Text_PairaSourceAgent_379C01}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="PairingDetailsWindow">
    <StackPanel Margin="20">
        <TextBlock Text="{local:Loc Text_Onetimepairingdetails_EA9AF7}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="{local:Loc Text_Entertheseonthecomputeryoureco_88AC93}" TextWrapping="Wrap" Foreground="#607086" Margin="0,0,0,14"/>
        <TextBlock x:Name="IntentText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10" AutomationProperties.AutomationId="PairingIntentText"/>

        <TextBlock Text="{local:Loc Text_Storageendpoint_919B9C}" Foreground="#607086"/>
        <TextBox x:Name="EndpointText" IsReadOnly="True" Margin="0,2,0,10" AutomationProperties.AutomationId="PairingEndpointText"/>

        <TextBlock Text="{local:Loc Text_Pairingcode_1C5EA2}" Foreground="#607086"/>
        <TextBox x:Name="CodeText" IsReadOnly="True" FontFamily="Consolas" Margin="0,2,0,10" AutomationProperties.AutomationId="PairingCodeText"/>

        <TextBlock Text="{local:Loc Text_CertificateSHA256fingerprint_F383F2}" Foreground="#607086"/>
        <TextBox x:Name="FingerprintText" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2,0,10" AutomationProperties.AutomationId="PairingFingerprintText"/>

        <TextBlock Text="{local:Loc Text_Expires_F6725F}" Foreground="#607086"/>
        <TextBox x:Name="ExpiresText" IsReadOnly="True" Margin="0,2,0,14" AutomationProperties.AutomationId="PairingExpiresText"/>

        <Border Background="#FFF6E5" BorderBrush="#E4C078" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
            <TextBlock TextWrapping="Wrap" Foreground="#7A5B12" Text="{local:Loc Text_Yourclipboardcanbereadbyotherp_5F8CBE}"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="CopyStatus" Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.AutomationId="CopyPairingStatusText"/>
            <Button Content="{local:Loc Text_Copytoclipboard_B749E2}" Click="OnCopyClick" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Padding="10,4" AutomationProperties.AutomationId="CopyPairingCodeButton"/>
            <Button Content="{local:Loc Text_Close_7D9EB7}" Click="OnCloseClick" IsCancel="True" Padding="10,4" AutomationProperties.AutomationId="ClosePairingDialogButton"/>
        </StackPanel>
    </StackPanel>
</Window>
