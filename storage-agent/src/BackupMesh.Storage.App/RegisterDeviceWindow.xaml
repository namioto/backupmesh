<Window x:Class="BackupMesh.Storage.App.RegisterDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register a drive or folder" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="RegisterDeviceWindow">
    <StackPanel Margin="20">
        <TextBlock Text="Register a drive or folder" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="Pick a connected drive below, or register a folder instead. Once it's registered, it's selected automatically for the backup you're creating." TextWrapping="Wrap" Foreground="#607086" Margin="0,0,0,14"/>
        <DockPanel Margin="0,0,0,2">
            <TextBlock Text="Connected drive" Foreground="#607086" DockPanel.Dock="Left"/>
            <Button Content="Refresh" Command="{Binding RefreshDrivesCommand}" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="8,2" AutomationProperties.AutomationId="RegisterDeviceDialogRefreshButton"/>
        </DockPanel>
        <ComboBox ItemsSource="{Binding AvailableDrives}" SelectedItem="{Binding SelectedAvailableDrive}" DisplayMemberPath="DisplayName" Margin="0,2,0,16" AutomationProperties.AutomationId="RegisterDeviceDialogDriveCombo"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Register folder instead…" Click="OnRegisterFolderClick" Margin="0,0,10,0" Padding="10,4" AutomationProperties.AutomationId="RegisterDeviceDialogFolderButton"/>
            <Button Content="Cancel" Click="OnCancelClick" IsCancel="True" Margin="0,0,10,0" Padding="10,4" AutomationProperties.AutomationId="RegisterDeviceDialogCancelButton"/>
            <Button Content="Register drive" Click="OnRegisterDriveClick" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Padding="10,4" AutomationProperties.AutomationId="RegisterDeviceDialogRegisterButton"/>
        </StackPanel>
    </StackPanel>
</Window>
