                        <TextBlock Text="{local:Loc Text_Fulldestinationpath_FA4DF9}" Foreground="#526987" Margin="0,0,0,7"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="DestinationInput" Style="{StaticResource SearchTextBoxStyle}" Margin="0" Padding="12,10" MinHeight="44" VerticalContentAlignment="Center" AutomationProperties.AutomationId="BackupRuleDestinationInput"/>
