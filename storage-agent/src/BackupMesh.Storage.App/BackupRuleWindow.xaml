    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock x:Name="HeadingText" Text="{local:Loc Text_Addbackuprule_3C4060}" Style="{StaticResource PageHeadingStyle}"/>
            <TextBlock Text="{local:Loc UX_335a46b3de}" Foreground="#60718D" Margin="0,7,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <Border Style="{StaticResource CardStyle}" Padding="20,12" Margin="0,0,0,10">
