                    <TextBox x:Name="RuleNameInput" Grid.Column="2" Style="{StaticResource SearchTextBoxStyle}" Height="42" Padding="12,0" Margin="0" MaxLength="128" FontSize="14" VerticalContentAlignment="Center" AutomationProperties.AutomationId="BackupRuleNameInput" AutomationProperties.Name="{local:Loc RuleNameLabel}"/>
