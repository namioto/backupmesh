<Window x:Class="BackupMesh.Storage.App.BackupRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BackupMesh.Storage.App"
        Title="{local:Loc Text_Addbackuprule_3C4060}" Width="760" MinWidth="680" Height="640" MinHeight="480" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="BackupRuleWindow">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" Text="{local:Loc Text_Addbackuprule_3C4060}" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="{local:Loc Text_Choosethesourceandwhereitsback_B1390C}"
                   TextWrapping="Wrap" Foreground="#607086" Margin="0,4,0,14"/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{local:Loc Text_Whattobackup_6B4FC3}" Foreground="#607086" Margin="4,0"/>
                <ComboBox x:Name="BackupSetCombo" ItemsSource="{Binding BackupSets}" SelectedItem="{Binding SelectedBackupSet, Mode=TwoWay}" DisplayMemberPath="DisplayName" SelectionChanged="OnBackupSetChanged" ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}"
                          AutomationProperties.AutomationId="BackupRuleBackupSetCombo"/>
                <Button Content="{local:Loc UXChooseThisPCFolder}" Command="{Binding AddLocalBackupSetCommand}" HorizontalAlignment="Left" Margin="4,4,4,0" Padding="10,5"
                        ToolTip="{local:Loc Text_BackupafolderonthisPCdirectlyn_11F9C0}" AutomationProperties.AutomationId="BackupRuleAddLocalBackupSetButton"/>
                <TextBlock Text="{local:Loc Text_Sourcepath_6A869D}" Foreground="#607086" Margin="4,8,4,0"/>
                <TextBox x:Name="SourcePathsText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="96" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.AutomationId="BackupRuleSourcePathsText"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <TextBlock Text="{local:Loc Text_Wheretostoreit_50E54D}" Foreground="#607086" Margin="4,0"/>
                <DockPanel>
                    <Button Content="{local:Loc Text_Choosefolder_6E8EB2}" DockPanel.Dock="Right" Click="OnChooseStorageFolderClick" Padding="9,5"
                            AutomationProperties.AutomationId="BackupRuleChooseStorageFolderButton"/>
                    <ComboBox x:Name="TargetDeviceCombo" ItemsSource="{Binding BackupDestinations}" DisplayMemberPath="DisplayName"
                              SelectionChanged="OnTargetChanged"
                              AutomationProperties.AutomationId="BackupRuleDeviceCombo"/>
                </DockPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{local:Loc Text_Fulldestinationpath_FA4DF9}" Foreground="#607086" Margin="4,0"/>
            <DockPanel>
                <Button Content="{local:Loc Text_Browse_93C6B6}" DockPanel.Dock="Right" Click="OnBrowseClick" Padding="10,5"
                        AutomationProperties.AutomationId="BackupRuleBrowseButton"/>
                <TextBox x:Name="DestinationInput" AutomationProperties.AutomationId="BackupRuleDestinationInput"/>
            </DockPanel>
            <TextBlock Text="{local:Loc Text_Thisisthecompletepathwheretheb_68B6C2}" TextWrapping="Wrap" Foreground="#8493A6" FontSize="11" Margin="4,0"/>
            <CheckBox x:Name="EnabledCheckBox" Content="{local:Loc Text_Enablethisbackuprule_9415CF}" IsChecked="True" Margin="4,12,4,0"
                      AutomationProperties.AutomationId="BackupRuleEnabledCheckBox"/>
        </StackPanel>

        </Grid>
        </ScrollViewer>
        <TextBlock Grid.Row="1" x:Name="ValidationText" Foreground="#C0392B" TextWrapping="Wrap" Margin="4,8,4,0"
                   AutomationProperties.AutomationId="BackupRuleValidationText"/>
        <Separator Grid.Row="2" Margin="0,16,0,10"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{local:Loc Text_Cancel_19766E}" Click="OnCancelClick" IsCancel="True"/>
            <Button x:Name="SaveButton" Content="{local:Loc Text_Addbackup_9C04C0}" Click="OnSaveClick" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="BackupRuleSaveButton"/>
        </StackPanel>
    </Grid>
</Window>
