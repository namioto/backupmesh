                        </Grid>
                        <TextBlock Text="{local:Loc Text_Thisisthecompletepathwheretheb_68B6C2}" TextWrapping="Wrap" Foreground="#60718D" FontSize="12" Margin="0,7,0,0"/>
                        <Border Background="#EFF7FC" CornerRadius="9" Padding="16" Margin="0,30,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="24" Height="24" CornerRadius="12" Background="#1675D1" Margin="0,0,10,0"><TextBlock Text="i" Foreground="White" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="{local:Loc UX_6d53264d17}" TextWrapping="Wrap" Foreground="#526987" VerticalAlignment="Center"/></Grid></Border>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource CardStyle}" Padding="24,16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{local:Loc UX_b0e900c976}" Style="{StaticResource CardHeadingStyle}" Margin="0,0,0,16"/>
                    <Grid TextElement.FontSize="12" TextElement.FontWeight="Normal">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="UploadDividerColumn" Width="1"/><ColumnDefinition x:Name="UploadSettingsColumn" Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="{local:Loc UX_34f3480226}" Foreground="#526987" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="BackupIntervalInput" Style="{StaticResource SearchTextBoxStyle}" Width="120" Height="42" Padding="12,0" VerticalContentAlignment="Center" AutomationProperties.AutomationId="BackupRuleIntervalInput"/>
                                <TextBlock Text="{local:Loc Text_minutes_90E63D}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#526987"/>
                            </StackPanel>
                            <TextBlock Text="{local:Loc UX_b087adc062}" TextWrapping="Wrap" Foreground="#60718D" FontSize="12" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#DFE8F2"/>
                        <StackPanel Grid.Column="2" Margin="22,0">
                            <CheckBox x:Name="DelayWhenBusyCheckBox" Content="{local:Loc UX_d158c2ae6e}" FontSize="13" IsChecked="True" AutomationProperties.AutomationId="BackupRuleDelayWhenBusyCheckBox"/>
                            <TextBlock Text="{local:Loc UX_5541b6e16a}" TextWrapping="Wrap" Foreground="#60718D" FontSize="12" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="3" Background="#DFE8F2"/>
                        <StackPanel x:Name="UploadLimitSection" Grid.Column="4" Margin="22,0,0,0">
                            <TextBlock Text="{local:Loc UX_c799f39b2f}" Foreground="#526987" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="UploadLimitInput" Style="{StaticResource SearchTextBoxStyle}" Width="150" Height="42" Padding="12,0" VerticalContentAlignment="Center" AutomationProperties.AutomationId="BackupRuleUploadLimitInput"/>
                                <TextBlock Text="KiB/s" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#526987"/>
                            </StackPanel>
                            <TextBlock Text="{local:Loc UX_51b9eb066a}" TextWrapping="Wrap" Foreground="#60718D" FontSize="12" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="ValidationText" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.AutomationId="BackupRuleValidationText"/>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="{local:Loc Text_Cancel_19766E}" Click="OnCancelClick" Style="{StaticResource OutlinedButtonStyle}" Margin="0,0,10,0" Padding="22,10"/>
                    <Button x:Name="SaveButton" Content="{local:Loc Text_Addbackup_9C04C0}" Click="OnSaveClick" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" FontSize="14" Margin="0" Padding="22,10" AutomationProperties.AutomationId="BackupRuleSaveButton"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
