<Window x:Class="BackupMesh.Storage.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BackupMesh.Storage.App"
        Title="BackupMesh Storage Agent" Height="720" Width="1080" MinHeight="620" MinWidth="900"
        Background="{StaticResource SurfaceBrush}" WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="MainWindow"
        Icon="Assets/backupmesh-tray.ico">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Border Background="{StaticResource NavyBrush}" Padding="22,14">
            <DockPanel LastChildFill="False">
                <Image Source="Assets/backupmesh-tray.png" Width="46" Height="46" Margin="0,0,14,0" DockPanel.Dock="Left"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BackupMesh" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Storage Agent" Foreground="#BEEAF2" FontSize="13"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#173E71" CornerRadius="16" Padding="14,7" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OverallStatus}" Foreground="White" AutomationProperties.AutomationId="OverallStatusText"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- Visible regardless of the active tab, because a first-click study found no tab arrangement
             could make "confirm the backup finished, then safely remove the drive" a single-tab task. -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding RemovalBanners}" AutomationProperties.AutomationId="RemovalBanners">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="0,0,0,1" Padding="18,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E8F5E9"/>
                                <Setter Property="BorderBrush" Value="#A5D6A7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:DeviceRemovalBannerKind.BackingUp}">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                        <Setter Property="BorderBrush" Value="#90CAF9"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:DeviceRemovalBannerKind.SafeButIncomplete}">
                                        <Setter Property="Background" Value="#FFF6E5"/>
                                        <Setter Property="BorderBrush" Value="#E4C078"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Remove safely" Style="{StaticResource PrimaryButtonStyle}" Padding="10,4" Margin="10,0,0,0"
                                    Command="{Binding DataContext.SafelyRemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Device}"
                                    Visibility="{Binding ShowRemoveButton, Converter={StaticResource BoolToVisibleConverter}}"
                                    AutomationProperties.AutomationId="RemoveSafelyButton"/>
                            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#3A3A3A"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TabControl Grid.Row="2" Margin="18" SelectionChanged="OnTabSelectionChanged" AutomationProperties.AutomationId="MainTabControl">
            <TabItem Header="Overview" AutomationProperties.AutomationId="OverviewTab">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <Border Background="White" CornerRadius="8" Padding="18" Margin="5"><StackPanel><TextBlock Text="Connected devices" Foreground="#607086"/><TextBlock Text="{Binding ConnectedDeviceCount}" FontSize="30" FontWeight="SemiBold" AutomationProperties.AutomationId="ConnectedDeviceCountText"/></StackPanel></Border>
                        <Border Background="White" CornerRadius="8" Padding="18" Margin="5"><StackPanel><TextBlock Text="Paired sources" Foreground="#607086"/><TextBlock Text="{Binding SourceCount}" FontSize="30" FontWeight="SemiBold" AutomationProperties.AutomationId="SourceCountText"/></StackPanel></Border>
                        <Border Background="White" CornerRadius="8" Padding="18" Margin="5"><StackPanel><TextBlock Text="Active mappings" Foreground="#607086"/><TextBlock Text="{Binding MappingCount}" FontSize="30" FontWeight="SemiBold" AutomationProperties.AutomationId="MappingCountText"/></StackPanel></Border>
                    </UniformGrid>
                    <GroupBox Grid.Row="1" Header="Backup jobs" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AutomationProperties.AutomationId="BackupJobsGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Backup" Binding="{Binding Target}" Width="2*"/>
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110"/>
                                    <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="2*"/>
                                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="*"/>
                                    <DataGridTextColumn Header="Updated" Binding="{Binding Updated}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No backup jobs yet. Jobs appear here once a mapped device is ready and a backup starts." TextWrapping="Wrap" Foreground="#8493A6" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="320" IsHitTestVisible="False" Visibility="{Binding Jobs.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>
                            <Button Grid.Row="1" Content="Cancel selected backup" Command="{Binding CancelJobCommand}" HorizontalAlignment="Right" Margin="0,8,0,0" AutomationProperties.AutomationId="CancelBackupButton"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Grid.Row="2" Header="Recent activity" Padding="12">
                        <ListBox ItemsSource="{Binding Activity}" BorderThickness="0" AutomationProperties.AutomationId="RecentActivityList"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Sources &amp; mappings" AutomationProperties.AutomationId="SourcesMappingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Connect a computer or a folder on this PC, then choose where each one backs up to." TextWrapping="Wrap" Foreground="#607086" Margin="0,0,0,10"/>
                    <GroupBox Grid.Row="1" Header="Computers" Padding="10" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DataGrid MinHeight="150" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSourceAgent}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AutomationProperties.AutomationId="SourceConnectionsGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Computer" Binding="{Binding DisplayName}" Width="2*"/>
                                    <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenDisplay}" Width="2*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="1" Text="{Binding SelectedComputerActionHint}" TextWrapping="Wrap" Foreground="#8493A6" FontSize="11" Margin="0,6,0,0"/>
                            <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                                <Button Content="Block access" Command="{Binding RevokeSourceCommand}" IsEnabled="{Binding HasSelectedSourceConnection}" Style="{StaticResource DangerButtonStyle}" Margin="0,4,6,0" ToolTip="Immediately block this computer from the control API, even with a valid certificate and token." AutomationProperties.AutomationId="RevokeSourceButton"/>
                                <Button Content="Restore access" Command="{Binding UnrevokeSourceCommand}" IsEnabled="{Binding HasSelectedSourceConnection}" Margin="0,4,6,0" AutomationProperties.AutomationId="UnrevokeSourceButton"/>
                                <Button Content="Re-pair" Command="{Binding RePairSourceCommand}" IsEnabled="{Binding HasSelectedSourceConnection}" Margin="0,4,6,0" ToolTip="Issue a new one-time code that can only re-pair this specific computer (for example, after its certificate or key was lost)." AutomationProperties.AutomationId="RePairSourceButton"/>
                                <Button Content="Rename" Command="{Binding RenameSourceCommand}" IsEnabled="{Binding HasSelectedSourceConnection}" Margin="0,4,6,0" ToolTip="Change only what the tray displays for this computer." AutomationProperties.AutomationId="RenameSourceButton"/>
                                <Button Content="Remove computer" Command="{Binding ForgetSourceCommand}" IsEnabled="{Binding HasSelectedSourceConnection}" Style="{StaticResource DangerButtonStyle}" Margin="0,4,6,0" ToolTip="Block this computer and remove it from this list. Its backups are kept but stop being reported until it is re-paired." AutomationProperties.AutomationId="ForgetSourceButton"/>
                            </WrapPanel>
                            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                <Button Content="Pair a computer" Command="{Binding PairSourceCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" ToolTip="Create a one-time 10-minute pairing code and pinned Storage certificate fingerprint." AutomationProperties.AutomationId="PairSourceButton"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="Back up a folder on this PC…" Command="{Binding AddLocalBackupSetCommand}" ToolTip="Back up a folder on this PC directly - no other computer or pairing needed." AutomationProperties.AutomationId="AddLocalBackupSetButton"/>
                                    <Button Content="Remove folder" Command="{Binding RemoveLocalBackupSetCommand}" Style="{StaticResource DangerButtonStyle}" Margin="6,0,0,0" ToolTip="Stop backing up the selected local folder. Its Backups are removed with it." AutomationProperties.AutomationId="RemoveLocalBackupSetButton"/>
                                </StackPanel>
                                <TextBlock Text="Backups sync from paired computers; &quot;This PC&quot; is always available for local folders." TextWrapping="Wrap" Foreground="#607086" Margin="4,4" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                    <GroupBox Grid.Row="1" Grid.Column="1" Header="Backups" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AutomationProperties.AutomationId="MappingsGrid">
                                <DataGrid.RowStyle>
                                    <!-- Trigger devices are configured per Backup Set, not per row - lightly
                                         tinting every other row for the same Backup Set as the selected one
                                         makes that scope visible without relying on reading the explanatory
                                         text below the trigger list. -->
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSiblingOfSelection}" Value="True">
                                                <Setter Property="Background" Value="#E4F6FA"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="What to back up" Binding="{Binding BackupSetName}" Width="2*"/>
                                    <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="*"/>
                                    <DataGridTextColumn Header="Destination folder" Binding="{Binding DestinationFolder}" Width="2*"/>
                                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, Mode=OneWay}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No backups yet. Choose what to back up and a device below, then Add backup." TextWrapping="Wrap" Foreground="#8493A6" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="320" IsHitTestVisible="False" Visibility="{Binding Mappings.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="What to back up" Margin="6,0" Foreground="#607086"/><ComboBox ItemsSource="{Binding BackupSets}" SelectedItem="{Binding SelectedBackupSet}" DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="BackupSetCombo"/><TextBlock Text="Folders shared by the computers on the left" Margin="6,2,0,0" FontSize="11" Foreground="#8493A6"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Device" Margin="6,0" Foreground="#607086"/><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayNameWithDetails" ToolTip="{Binding SelectedDevice.DisplayNameWithDetails}" AutomationProperties.AutomationId="MappingDeviceCombo"/><TextBlock Text="Registered in the Devices tab" Margin="6,2,0,0" FontSize="11" Foreground="#8493A6" Visibility="{Binding Devices.Count, Converter={StaticResource ZeroToVisibleConverter}}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Destination folder" Margin="6,0" Foreground="#607086"/><DockPanel><Button Content="Browse…" Command="{Binding BrowseDestinationCommand}" DockPanel.Dock="Right" Margin="6,0,0,0" AutomationProperties.AutomationId="BrowseDestinationButton"/><TextBox Text="{Binding NewDestinationFolder, UpdateSourceTrigger=PropertyChanged}" ToolTip="Folder on the selected device" AutomationProperties.AutomationId="DestinationFolderInput"/></DockPanel></StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Remove backup" Command="{Binding RemoveMappingCommand}" AutomationProperties.AutomationId="RemoveMappingButton"/>
                                    <Button Content="Add backup" Command="{Binding AddMappingCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="AddMappingButton"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </GroupBox>
                    <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Header="{Binding TriggerGroupHeader}" Margin="0,10,0,0" Padding="10">
                        <Grid>
                            <TextBlock Text="Select a backup above to choose which devices should start it automatically." Foreground="#8493A6" TextWrapping="Wrap" Visibility="{Binding SelectedMapping, Converter={StaticResource NullToVisibleConverter}}"/>
                            <StackPanel Visibility="{Binding SelectedMapping, Converter={StaticResource NullToCollapsedConverter}}">
                                <TextBlock Text="{Binding SiblingScopeNotice}" Visibility="{Binding SelectedMappingHasSiblings, Converter={StaticResource BoolToVisibleConverter}}" TextWrapping="Wrap" Foreground="#607086" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SelectedMapping.SavesToLine}" TextWrapping="Wrap" Foreground="#607086"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#607086" Margin="0,0,0,8"
                                           ToolTip="A device used only to trigger a backup does not need a destination of its own. Leave none selected to keep the automatic behavior: any connected device whose root contains this backup's source folder.">
                                    Choose which registered devices should start it automatically — usually the same one.
                                </TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ListBox x:Name="TriggerDevicesListBox" ItemsSource="{Binding Devices}" DisplayMemberPath="DisplayName" SelectionMode="Extended" Height="90" SelectionChanged="OnTriggerDevicesSelectionChanged" AutomationProperties.AutomationId="TriggerDevicesListBox"/>
                                        <TextBlock Text="Registered in the Devices tab" Margin="0,2,0,0" FontSize="11" Foreground="#8493A6" Visibility="{Binding Devices.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                                        <RadioButton x:Name="AnyDeviceTriggerRadio" GroupName="TriggerPolicy" Content="Start when any of these devices connects" Checked="OnTriggerDevicesSelectionChanged" AutomationProperties.AutomationId="AnyDeviceTriggerRadio"/>
                                        <RadioButton x:Name="AllDevicesTriggerRadio" GroupName="TriggerPolicy" Content="Start only when all of them are connected" Checked="OnTriggerDevicesSelectionChanged" Margin="0,6,0,0" ToolTip="Only meaningful with more than one selected device: wait until every one of them is connected before backing up." AutomationProperties.AutomationId="AllDevicesTriggerRadio"/>
                                        <TextBlock Text="{Binding SelectedMapping.BackupSet.TriggerSummary}" Margin="0,10,0,0" Foreground="#607086" TextWrapping="Wrap" MaxWidth="220" AutomationProperties.AutomationId="TriggerSummaryText"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Devices" AutomationProperties.AutomationId="DevicesTab">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Register the drives and folders your backups are allowed to use." TextWrapping="Wrap" Foreground="#607086" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AutomationProperties.AutomationId="RegisteredDevicesGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device" Binding="{Binding DisplayNameWithDetails}" Width="2*"/>
                            <DataGridTextColumn Header="Volume" Binding="{Binding VolumeLabel}" Width="*"/>
                            <DataGridTextColumn Header="Current location" Binding="{Binding CurrentRoot}" Width="*"/>
                            <DataGridTextColumn Header="Free space" Binding="{Binding FreeSpaceDisplay}" Width="*"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding RoleDisplay}" Width="*" ToolTipService.ToolTip="A device only starts a backup automatically when it's explicitly chosen for that in Sources &amp; mappings."/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                            <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenDisplay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="No devices registered yet. Pick a detected drive below and Register selected device, or Register folder…" TextWrapping="Wrap" Foreground="#8493A6" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="320" IsHitTestVisible="False" Visibility="{Binding Devices.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="360" ItemsSource="{Binding AvailableDrives}" SelectedItem="{Binding SelectedAvailableDrive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="AvailableDrivesCombo"/>
                            <Button Content="Refresh drives" Command="{Binding RefreshDrivesCommand}" AutomationProperties.AutomationId="RefreshDrivesButton"/>
                            <Button Content="Register selected device" Command="{Binding RegisterDeviceCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="RegisterDeviceButton"/>
                            <Button Content="Register folder…" Command="{Binding RegisterFolderCommand}" ToolTip="Use a local or network folder as a logical storage device." AutomationProperties.AutomationId="RegisterFolderButton"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Stop using this device" Command="{Binding ForgetDeviceCommand}" Style="{StaticResource DangerButtonStyle}" ToolTip="Backup data already stored on it is not deleted; only Storage stops sending new backups to it." AutomationProperties.AutomationId="ForgetDeviceButton"/>
                            <Button Content="Safely remove selected device" Command="{Binding EjectDeviceCommand}" AutomationProperties.AutomationId="EjectDeviceButton"/>
                            <TextBlock Text="Wait before starting, after this device connects:" Margin="18,0,6,0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SelectedDevice.ArrivalDelayMinutes}" Width="55" AutomationProperties.AutomationId="ArrivalDelayInput"/>
                            <TextBlock Text="minutes" VerticalAlignment="Center" Margin="5,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Settings" AutomationProperties.AutomationId="SettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="650" HorizontalAlignment="Left">
                        <TextBlock Text="Automation" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox Content="Start BackupMesh when I sign in" IsChecked="{Binding StartWithWindows}" Margin="4,8" AutomationProperties.AutomationId="StartWithWindowsCheckBox"/>
                        <CheckBox Content="Show a Windows notification when a registered device is connected" IsChecked="{Binding NotifyOnDeviceArrival}" Margin="4,8" AutomationProperties.AutomationId="NotifyOnDeviceArrivalCheckBox"/>
                        <CheckBox Content="Automatically start eligible backups after the grace period" IsChecked="{Binding AutomaticBackups}" Margin="4,8" AutomationProperties.AutomationId="AutomaticBackupsCheckBox"/>
                        <Separator Margin="0,18"/>
                        <TextBlock Text="Data location" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Choose a destination folder for every backup target. BackupMesh internally keeps the folder relative to its registered device so removable-drive letter changes do not break mappings. Fixed drives, removable storage, and registered local or network folders are supported." TextWrapping="Wrap" Foreground="#526276"/>
                        <Button Content="Save settings" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,18,0,0" AutomationProperties.AutomationId="SaveSettingsButton"/>
                        <Separator Margin="0,18"/>
                        <TextBlock Text="Security" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#526276" Margin="0,0,0,10">
                            Rotating the Storage identity regenerates its certificate authority and server certificate. Every currently paired computer loses access until it is re-paired, and the change only takes effect after the BackupMesh Storage service is restarted.
                        </TextBlock>
                        <Button Content="Rotate Storage identity" Command="{Binding RotateStorageIdentityCommand}" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,24" AutomationProperties.AutomationId="RotateStorageIdentityButton"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="#E8EDF4" Padding="12,6"><TextBlock Text="{Binding FooterStatus}" Foreground="#44566C" AutomationProperties.AutomationId="FooterStatusText"/></Border>
    </Grid>
</Window>
