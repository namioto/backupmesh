<Window x:Class="BackupMesh.Storage.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BackupMesh.Storage.App"
        Title="{local:Loc Text_BackupMeshStorageAgent_CABABF}" Height="760" Width="1120" MinHeight="640" MinWidth="920"
        Background="{StaticResource SurfaceBrush}" WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="MainWindow"
        Icon="Assets/backupmesh-tray.ico">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Border Background="{StaticResource NavyBrush}" Padding="20,8">
            <DockPanel LastChildFill="False">
                <Image Source="Assets/backupmesh-tray.png" Width="36" Height="36" Margin="0,0,12,0" DockPanel.Dock="Left"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BackupMesh" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{local:Loc Text_StorageAgent_0CA177}" Foreground="#BEEAF2" FontSize="11"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#173E71" CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OverallStatus}" Foreground="White" AutomationProperties.AutomationId="OverallStatusText"/>
                </Border>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="18" SelectionChanged="OnTabSelectionChanged" AutomationProperties.AutomationId="MainTabControl">
            <TabItem Header="{local:Loc Text_Overview_D4B1EA}" AutomationProperties.AutomationId="OverviewTab">
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="{local:Loc Text_Overview_D4B1EA}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding OverallStatus}" Foreground="#526276" AutomationProperties.AutomationId="OverviewStatusText"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{local:Loc UXConnectComputer}" Click="OnGoToComputersClick" AutomationProperties.AutomationId="OverviewConnectComputerButton"/>
                                <Button Content="{local:Loc Text_Addbackup_8026D5}" Click="OnAddMappingClick" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="OverviewAddBackupButton"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{local:Loc NextBackup}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="{local:Loc Text_Backups_3334FE}" Click="OnGoToBackupsClick" Padding="10,5" AutomationProperties.AutomationId="OverviewViewBackupsButton"/>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" MaxHeight="110" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Mappings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SourceAgentName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DeviceName}" TextTrimming="CharacterEllipsis" Foreground="#526276" Margin="12,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding NextBackupDisplay}" TextWrapping="Wrap" Foreground="#2563A8"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <GroupBox Grid.Row="2" Header="{local:Loc Text_Backupjobs_399BA4}" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AutomationProperties.AutomationId="BackupJobsGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{local:Loc Text_Backup_838557}" Binding="{Binding Target}" Width="2*" ElementStyle="{StaticResource EllipsisCellStyle}"/>
                                    <DataGridTextColumn Header="{local:Loc Text_State_A3B50C}" Binding="{Binding StateDisplay}" Width="110"/>
                                    <DataGridTextColumn Header="{local:Loc Text_Progress_466482}" Binding="{Binding Progress}" Width="2*" ElementStyle="{StaticResource EllipsisCellStyle}"/>
                                    <DataGridTextColumn Header="{local:Loc Text_Result_6E7D50}" Binding="{Binding Result}" Width="*" ElementStyle="{StaticResource EllipsisCellStyle}"/>
                                    <DataGridTextColumn Header="{local:Loc Text_Updated_3A5ECC}" Binding="{Binding Updated}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Visibility="{Binding Jobs.Count, Converter={StaticResource ZeroToVisibleConverter}}">
                                <TextBlock Text="{local:Loc Text_NobackupjobsyetJobsappearhereo_DF8946}" TextWrapping="Wrap" Foreground="#607086" TextAlignment="Center"/>
                                <Button Content="{local:Loc Text_Addbackup_8026D5}" Click="OnAddMappingClick" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Margin="0,10,0,0" AutomationProperties.AutomationId="OverviewEmptyAddBackupButton"/>
                            </StackPanel>
                            <Button Grid.Row="1" Content="{local:Loc Text_Cancelselectedbackup_F89A69}" Command="{Binding CancelJobCommand}" HorizontalAlignment="Right" Margin="0,8,0,0" AutomationProperties.AutomationId="CancelBackupButton"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Grid.Row="3" Header="{local:Loc Text_Recentactivity_6CB44B}" Padding="12">
                        <ListBox ItemsSource="{Binding Activity}" BorderThickness="0" AutomationProperties.AutomationId="RecentActivityList"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem x:Name="BackupsTabItem" Header="{local:Loc Text_Backups_3334FE}" AutomationProperties.AutomationId="BackupsTab">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{local:Loc Text_Choosewhattobackupandwhereeach_AFABC9}" TextWrapping="Wrap" Foreground="#607086" Margin="0,0,0,10"/>
                    <GroupBox Grid.Row="1" Header="{local:Loc Text_Backuprules_566313}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      MinHeight="300" MouseDoubleClick="OnMappingDoubleClick" AutomationProperties.AutomationId="MappingsGrid">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter Property="Opacity" Value="0.55"/>
                                                <Setter Property="BorderBrush" Value="#B0B8C2"/>
                                                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Resources>
                                    <Style x:Key="RepeatDimmedCellStyle" TargetType="TextBlock" BasedOn="{StaticResource EllipsisCellStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRepeatOfPreviousSource}" Value="True">
                                                <Setter Property="Foreground" Value="#A9B2BE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style x:Key="RepeatDimmedFolderNameStyle" TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRepeatOfPreviousSourceFolder}" Value="True">
                                                <Setter Property="Foreground" Value="#A9B2BE"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style x:Key="RepeatDimmedFolderPathsStyle" TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#8493A6"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRepeatOfPreviousSourceFolder}" Value="True">
                                                <Setter Property="Foreground" Value="#C3C9D1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{local:Loc BackupFolder}" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,2" ToolTip="{Binding SourcePathsDisplay}">
                                                    <TextBlock Text="{Binding BackupSetOnlyName}" Style="{StaticResource RepeatDimmedFolderNameStyle}"/>
                                                    <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" Style="{StaticResource RepeatDimmedFolderPathsStyle}">
                                                        <Run Text="{Binding SourceAgentName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SourcePathsDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{local:Loc StorageLocation}" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,2" ToolTip="{Binding DestinationFolder}">
                                                    <TextBlock Text="{Binding DestinationFolder}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DeviceName}" FontSize="11" Foreground="#8493A6" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{local:Loc NextBackup}" Width="1.6*">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding NextBackupDisplay}" Margin="4,2" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{local:Loc Text_Lastbackup_8462B6}" Width="1.4*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,2">
                                                    <TextBlock Text="{Binding LastBackupDisplay}"/>
                                                    <!-- A small leading glyph plus color keeps this line from
                                                         reading as more of the same "when" fact above it - one
                                                         is neutral context, the other needs attention. -->
                                                    <TextBlock FontSize="11" Foreground="#8493A6" TextWrapping="Wrap" Visibility="{Binding TriggerNote, Converter={StaticResource StringEmptyToCollapsedConverter}}">
                                                        <Run Text="ⓘ "/><Run Text="{Binding TriggerNote, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="#B45309" TextWrapping="Wrap" Visibility="{Binding LastBackupIssue, Converter={StaticResource StringEmptyToCollapsedConverter}}">
                                                        <Run Text="⚠ "/><Run Text="{Binding LastBackupIssue, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridCheckBoxColumn Header="{local:Loc Text_Enabled_92C1CD}" Binding="{Binding Enabled}" IsReadOnly="False" Width="Auto" ToolTipService.ToolTip="{local:Loc Text_Pausethisbackupwithoutremoving_0ED5D5}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{local:Loc Text_NobackuprulesyetAddonetochoose_7C46A4}" TextWrapping="Wrap" Foreground="#8493A6" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="360" IsHitTestVisible="False" Visibility="{Binding Mappings.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{local:Loc Text_Removebackup_2D2646}" Command="{Binding RemoveMappingCommand}" IsEnabled="{Binding HasSelectedMapping}" AutomationProperties.AutomationId="RemoveMappingButton"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding StartSelectedMappingHint}" Foreground="#B45309" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0" Visibility="{Binding StartSelectedMappingHint, Converter={StaticResource StringEmptyToCollapsedConverter}}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="{local:Loc Text_Editbackup_9CBB38}" Click="OnEditMappingClick" IsEnabled="{Binding HasSelectedMapping}" AutomationProperties.AutomationId="EditMappingButton"/>
                                    <Button Content="{local:Loc Text_Addbackup_8026D5}" Click="OnAddMappingClick" AutomationProperties.AutomationId="AddMappingButton"/>
                                    <Button Content="{local:Loc Text_Startnow_9FF3A6}" Command="{Binding QueueSelectedMappingCommand}" IsEnabled="{Binding CanStartSelectedMapping}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="StartSelectedBackupButton"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Use Source Agent consistently for the managed software identity; use computer only when
                 referring to the physical machine. -->
            <TabItem x:Name="ComputersTabItem" Header="{local:Loc Text_SourceAgents_016D07}" AutomationProperties.AutomationId="SourceAgentsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{local:Loc Text_EachcomputeryoupairrunsaSource_32AFD1}" TextWrapping="Wrap" Foreground="#607086" Margin="0,0,0,10"/>
                    <GroupBox Grid.Row="1" Header="{local:Loc Text_SourceAgents_016D07}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DataGrid MinHeight="150" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedRemoteAgent}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AutomationProperties.AutomationId="SourceConnectionsGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{local:Loc Text_SourceAgent_21CF69}" Binding="{Binding DisplayNameWithHint}" Width="1.7*" ElementStyle="{StaticResource EllipsisCellStyle}"/>
                                    <DataGridTextColumn Header="{local:Loc Text_Lastseen_21FD79}" Binding="{Binding LastSeenDisplay}" Width="1.4*"/>
                                    <!-- Status may contain a recovery deadline; preserve room and expose the
                                         complete value through the shared ellipsis/tooltip behavior. -->
                                    <DataGridTextColumn Header="{local:Loc Text_Status_920E41}" Binding="{Binding StatusDisplay}" Width="2.2*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="ToolTip" Value="{Binding StatusDisplay}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{local:Loc Text_Offers_E98BF0}" Binding="{Binding PathsServedDisplay}" Width="1.6*" ElementStyle="{StaticResource EllipsisCellStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Right">
                                <Button Content="{local:Loc Text_Rename_3064D7}" Command="{Binding RenameSourceCommand}" IsEnabled="{Binding HasSelectedSourceConnection}" Margin="0,4,6,0" ToolTip="{local:Loc Text_Changeonlywhatthetraydisplaysf_8E2E3E}" AutomationProperties.AutomationId="RenameSourceButton"/>
                                <Button Content="{local:Loc Text_RemoveSourceAgent_ED5EE3}" Command="{Binding ForgetSourceCommand}" IsEnabled="{Binding HasSelectedSourceConnection}" Style="{StaticResource DangerButtonStyle}" Margin="0,4,6,0" ToolTip="{local:Loc Text_BlockthisSourceAgentandremovei_1A5808}" AutomationProperties.AutomationId="ForgetSourceButton"/>
                            </WrapPanel>
                        </Grid>
                    </GroupBox>
                    <GroupBox Grid.Row="2" Header="{local:Loc NearbyComputers}" Padding="10" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{local:Loc NearbyDiscoveryWarning}" TextWrapping="Wrap" Foreground="#607086" Margin="0,0,0,8"/>
                            <DataGrid Grid.Row="1" MinHeight="110" ItemsSource="{Binding NearbyComputers}" SelectedItem="{Binding SelectedNearbyComputer}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AutomationProperties.AutomationId="NearbyComputersGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{local:Loc NearbyName}" Binding="{Binding DisplayName}" Width="2*" ElementStyle="{StaticResource EllipsisCellStyle}"/>
                                    <DataGridTextColumn Header="{local:Loc Text_Lastseen_21FD79}" Binding="{Binding LastSeenDisplay}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <TextBlock Text="{Binding NearbyPairingStatus}" TextWrapping="Wrap"/>
                                <Border Background="#FFF7D6" BorderBrush="#D69E2E" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,8,0,0" Visibility="{Binding HasNearbyComparisonCode, Converter={StaticResource BoolToVisibleConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{local:Loc NearbyComparisonInstructions}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding NearbyComparisonCode}" FontSize="30" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,6,0,0" AutomationProperties.AutomationId="NearbyComparisonCode"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                                <Button Content="{local:Loc NearbyRequestPairing}" Command="{Binding RequestNearbyPairingCommand}" IsEnabled="{Binding HasSelectedNearbyComputer}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="RequestNearbyPairingButton"/>
                                <Button Content="{local:Loc NearbyCancelPairing}" Command="{Binding CancelNearbyPairingCommand}" IsEnabled="{Binding CanCancelNearbyPairing}" Margin="6,0,0,0" AutomationProperties.AutomationId="CancelNearbyPairingButton"/>
                                <Button Content="{local:Loc NearbyRefresh}" Command="{Binding RefreshNearbyComputersCommand}" Margin="6,0,0,0" AutomationProperties.AutomationId="RefreshNearbyComputersButton"/>
                            </WrapPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{local:Loc Text_Settings_74A883}" AutomationProperties.AutomationId="SettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="{local:Loc Text_Language_A4FE65}" FontSize="20" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectedValue="{Binding Language}" Width="240" HorizontalAlignment="Left" AutomationProperties.AutomationId="LanguageCombo"/>
                        <TextBlock Text="{local:Loc Text_SavedautomaticallyExitBackupMe_6E29AA}" TextWrapping="Wrap" Foreground="#607086" Margin="0,4,0,20"/>
                        <TextBlock Text="{local:Loc Text_Automation_D90975}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox Content="{local:Loc Text_StartBackupMeshwhenIsignin_A44225}" IsChecked="{Binding StartWithWindows}" Margin="4,8" AutomationProperties.AutomationId="StartWithWindowsCheckBox"/>
                        <CheckBox Content="{local:Loc Text_ShowaWindowsnotificationwhenab_B5FAB9}" IsChecked="{Binding NotifyOnDeviceArrival}" Margin="4,8" AutomationProperties.AutomationId="NotifyOnDeviceArrivalCheckBox"/>
                        <CheckBox Content="{local:Loc Text_Automaticallystarteligibleback_02F7BF}" IsChecked="{Binding AutomaticBackups}" Margin="4,8" AutomationProperties.AutomationId="AutomaticBackupsCheckBox"/>
                        <CheckBox Content="{local:Loc Text_Showastatuswindowwhenabackupst_8A774A}" IsChecked="{Binding ShowFlyoutOnBackupStart}" Margin="4,8" ToolTip="{local:Loc Text_Asmallpopupnearthetrayiconwith_C54240}" AutomationProperties.AutomationId="ShowFlyoutOnBackupStartCheckBox"/>
                        <StackPanel Orientation="Horizontal" Margin="4,8">
                            <TextBlock Text="{local:Loc Text_Waitbeforestartingafteranytarg_F8504D}" VerticalAlignment="Center" ToolTip="{local:Loc Text_Appliestoeverybackuptarget_F4D827}"/>
                            <TextBox Text="{Binding DefaultArrivalDelayMinutes}" Width="55" Margin="6,0" AutomationProperties.AutomationId="DefaultArrivalDelayInput"/>
                            <TextBlock Text="{local:Loc Text_minutes_90E63D}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="{local:Loc Text_Savesettings_7F3A3B}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,18,0,0" AutomationProperties.AutomationId="SaveSettingsButton"/>
                        <Separator Margin="0,18"/>
                        <Expander Header="{local:Loc Text_Security_8F6FB4}" Margin="0,0,0,18">
                            <Border Background="#FFF8F6" BorderBrush="#E8C7C0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Foreground="#6F3B32" Margin="0,0,0,10" Text="{local:Loc Text_RotatingtheStorageidentityrege_47B7C4}"/>
                                    <Button Content="{local:Loc Text_RotateStorageidentity_8CA37E}" Command="{Binding RotateStorageIdentityCommand}" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Left" AutomationProperties.AutomationId="RotateStorageIdentityButton"/>
                                </StackPanel>
                            </Border>
                        </Expander>
                        <Separator Margin="0,8"/>
                        <TextBlock Text="{local:Loc Text_AboutBackupMesh_0F063F}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ProductVersion}" Margin="0,8"/>
                        <TextBlock Text="{local:Loc Text_Automaticbackupswhenyourstorag_6BDA2D}" TextWrapping="Wrap"/>
                        <TextBlock Text="{local:Loc Text_CreatedbynamiotoApache20_6CDCF2}" Margin="0,6"/>
                        <TextBlock Margin="0,6" TextWrapping="Wrap">
                            <Hyperlink NavigateUri="https://github.com/namioto/backupmesh" RequestNavigate="OnProjectLink" AutomationProperties.AutomationId="ProjectLink">github.com/namioto/backupmesh</Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="0,6" TextWrapping="Wrap">
                            <Hyperlink NavigateUri="https://github.com/namioto/backupmesh/blob/main/docs/USER_GUIDE.md" RequestNavigate="OnProjectLink"><Run Text="{local:Loc Text_Userguide_86A2A9}"/></Hyperlink>
                            <Run Text=" · "/>
                            <Hyperlink NavigateUri="https://github.com/namioto/backupmesh/issues" RequestNavigate="OnProjectLink"><Run Text="{local:Loc Text_Reportanissue_635AE2}"/></Hyperlink>
                            <Run Text=" · "/>
                            <Hyperlink NavigateUri="https://github.com/namioto/backupmesh/blob/main/LICENSE" RequestNavigate="OnProjectLink"><Run Text="{local:Loc Text_License_C011D6}"/></Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#E8EDF4" Padding="12,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0"><Run Text="{Binding ProductVersion, Mode=OneWay}"/><Run Text=" · "/><Hyperlink NavigateUri="https://github.com/namioto/backupmesh" RequestNavigate="OnProjectLink" AutomationProperties.AutomationId="FooterGitHubLink">GitHub</Hyperlink></TextBlock>
                <TextBlock Text="{Binding FooterStatus}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FooterStatus}" Foreground="#44566C" AutomationProperties.AutomationId="FooterStatusText"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
