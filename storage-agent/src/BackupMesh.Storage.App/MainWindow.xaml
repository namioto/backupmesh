<Window x:Class="BackupMesh.Storage.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BackupMesh Storage Agent" Height="720" Width="1080" MinHeight="620" MinWidth="900"
        Background="{StaticResource SurfaceBrush}" WindowStartupLocation="CenterScreen"
        Icon="Assets/backupmesh-tray.ico">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Border Background="{StaticResource NavyBrush}" Padding="22,14">
            <DockPanel>
                <Image Source="Assets/backupmesh-tray.png" Width="46" Height="46" Margin="0,0,14,0" DockPanel.Dock="Left"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BackupMesh" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Storage Agent" Foreground="#BEEAF2" FontSize="13"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#173E71" CornerRadius="16" Padding="14,7" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OverallStatus}" Foreground="White"/>
                </Border>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="18">
            <TabItem Header="Overview">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <Border Background="White" CornerRadius="8" Padding="18" Margin="5"><StackPanel><TextBlock Text="Connected devices" Foreground="#607086"/><TextBlock Text="{Binding ConnectedDeviceCount}" FontSize="30" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Background="White" CornerRadius="8" Padding="18" Margin="5"><StackPanel><TextBlock Text="Paired sources" Foreground="#607086"/><TextBlock Text="{Binding SourceCount}" FontSize="30" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Background="White" CornerRadius="8" Padding="18" Margin="5"><StackPanel><TextBlock Text="Active mappings" Foreground="#607086"/><TextBlock Text="{Binding MappingCount}" FontSize="30" FontWeight="SemiBold"/></StackPanel></Border>
                    </UniformGrid>
                    <GroupBox Grid.Row="1" Header="Recent activity" Padding="12">
                        <ListBox ItemsSource="{Binding Activity}" BorderThickness="0"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Sources &amp; mappings">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                    <GroupBox Header="Paired Source Agents" Padding="10" Margin="0,0,10,0">
                        <TreeView ItemsSource="{Binding Sources}" SelectedItemChanged="OnSourceSelectionChanged">
                            <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding BackupSets}"><TextBlock Text="{Binding DisplayName}"/></HierarchicalDataTemplate></TreeView.ItemTemplate>
                        </TreeView>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="Backup targets" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Source / Backup set" Binding="{Binding BackupSetName}" Width="2*"/>
                                    <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="*"/>
                                    <DataGridTextColumn Header="Repository path" Binding="{Binding RepositoryPath}" Width="2*"/>
                                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                                <ComboBox Width="220" ItemsSource="{Binding BackupSets}" SelectedItem="{Binding SelectedBackupSet}" DisplayMemberPath="DisplayName"/>
                                <ComboBox Width="190" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayName"/>
                                <TextBox Width="220" Text="{Binding NewRepositoryPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Relative path on the selected device"/>
                                <Button Content="Add mapping" Command="{Binding AddMappingCommand}"/>
                                <Button Content="Remove selected" Command="{Binding RemoveMappingCommand}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Devices">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device" Binding="{Binding DisplayName}" Width="2*"/>
                            <DataGridTextColumn Header="Volume" Binding="{Binding VolumeLabel}" Width="*"/>
                            <DataGridTextColumn Header="Current location" Binding="{Binding CurrentRoot}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                            <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenDisplay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <ComboBox Width="360" ItemsSource="{Binding AvailableDrives}" SelectedItem="{Binding SelectedAvailableDrive}" DisplayMemberPath="DisplayName"/>
                        <Button Content="Refresh drives" Command="{Binding RefreshDrivesCommand}"/>
                        <Button Content="Register selected device" Command="{Binding RegisterDeviceCommand}"/>
                        <Button Content="Forget device" Command="{Binding ForgetDeviceCommand}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <StackPanel Margin="24" MaxWidth="650" HorizontalAlignment="Left">
                    <TextBlock Text="Automation" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <CheckBox Content="Start BackupMesh when I sign in" IsChecked="{Binding StartWithWindows}" Margin="4,8"/>
                    <CheckBox Content="Show a Windows notification when a registered device is connected" IsChecked="{Binding NotifyOnDeviceArrival}" Margin="4,8"/>
                    <CheckBox Content="Automatically start eligible backups after the grace period" IsChecked="{Binding AutomaticBackups}" Margin="4,8"/>
                    <DockPanel Margin="4,12"><TextBlock Text="Grace period after device arrival" Width="260" VerticalAlignment="Center"/><TextBox Text="{Binding GracePeriodMinutes}" Width="90"/><TextBlock Text="minutes" VerticalAlignment="Center"/></DockPanel>
                    <Separator Margin="0,18"/>
                    <TextBlock Text="Data location" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Each mapping stores one Source backup set in a relative repository path on its selected device. Multiple mappings may target the same device, but enabled mappings cannot share the exact same repository path." TextWrapping="Wrap" Foreground="#526276"/>
                    <Button Content="Save settings" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#E8EDF4" Padding="12,6"><TextBlock Text="{Binding FooterStatus}" Foreground="#44566C"/></Border>
    </Grid>
</Window>
