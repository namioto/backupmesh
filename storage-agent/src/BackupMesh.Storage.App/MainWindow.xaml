<Window x:Class="BackupMesh.Storage.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BackupMesh Storage Agent" Height="720" Width="1080" MinHeight="620" MinWidth="900"
        Background="{StaticResource SurfaceBrush}" WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="MainWindow"
        Icon="Assets/backupmesh-tray.ico">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Border Background="{StaticResource NavyBrush}" Padding="22,14">
            <DockPanel>
                <Image Source="Assets/backupmesh-tray.png" Width="46" Height="46" Margin="0,0,14,0" DockPanel.Dock="Left"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BackupMesh" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Storage Agent" Foreground="#BEEAF2" FontSize="13"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#173E71" CornerRadius="16" Padding="14,7" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OverallStatus}" Foreground="White" AutomationProperties.AutomationId="OverallStatusText"/>
                </Border>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="18" AutomationProperties.AutomationId="MainTabControl">
            <TabItem Header="Overview" AutomationProperties.AutomationId="OverviewTab">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <Border Background="White" CornerRadius="8" Padding="18" Margin="5"><StackPanel><TextBlock Text="Connected devices" Foreground="#607086"/><TextBlock Text="{Binding ConnectedDeviceCount}" FontSize="30" FontWeight="SemiBold" AutomationProperties.AutomationId="ConnectedDeviceCountText"/></StackPanel></Border>
                        <Border Background="White" CornerRadius="8" Padding="18" Margin="5"><StackPanel><TextBlock Text="Paired sources" Foreground="#607086"/><TextBlock Text="{Binding SourceCount}" FontSize="30" FontWeight="SemiBold" AutomationProperties.AutomationId="SourceCountText"/></StackPanel></Border>
                        <Border Background="White" CornerRadius="8" Padding="18" Margin="5"><StackPanel><TextBlock Text="Active mappings" Foreground="#607086"/><TextBlock Text="{Binding MappingCount}" FontSize="30" FontWeight="SemiBold" AutomationProperties.AutomationId="MappingCountText"/></StackPanel></Border>
                    </UniformGrid>
                    <GroupBox Grid.Row="1" Header="Backup jobs" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AutomationProperties.AutomationId="BackupJobsGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110"/>
                                    <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="2*"/>
                                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="*"/>
                                    <DataGridTextColumn Header="Updated" Binding="{Binding Updated}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Grid.Row="1" Content="Cancel selected backup" Command="{Binding CancelJobCommand}" HorizontalAlignment="Right" Margin="0,8,0,0" AutomationProperties.AutomationId="CancelBackupButton"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Grid.Row="2" Header="Recent activity" Padding="12">
                        <ListBox ItemsSource="{Binding Activity}" BorderThickness="0" AutomationProperties.AutomationId="RecentActivityList"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Sources &amp; mappings" AutomationProperties.AutomationId="SourcesMappingsTab">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                    <GroupBox Header="Paired Source Agents" Padding="10" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="1.2*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TreeView ItemsSource="{Binding Sources}" SelectedItemChanged="OnSourceSelectionChanged" AutomationProperties.AutomationId="PairedSourcesTree">
                                <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding BackupSets}"><TextBlock Text="{Binding DisplayName}"/></HierarchicalDataTemplate></TreeView.ItemTemplate>
                            </TreeView>
                            <GroupBox Grid.Row="1" Header="Connections" Margin="0,10,0,0" Padding="6">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <DataGrid ItemsSource="{Binding SourceConnections}" SelectedItem="{Binding SelectedSourceConnection}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AutomationProperties.AutomationId="SourceConnectionsGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Source" Binding="{Binding AgentName}" Width="2*"/>
                                            <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenDisplay}" Width="2*"/>
                                            <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Revoke" Command="{Binding RevokeSourceCommand}" ToolTip="Immediately block this Source Agent from the control API, even with a valid certificate and token." AutomationProperties.AutomationId="RevokeSourceButton"/>
                                        <Button Content="Restore access" Command="{Binding UnrevokeSourceCommand}" Margin="6,0,0,0" AutomationProperties.AutomationId="UnrevokeSourceButton"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                            <StackPanel Grid.Row="2" Margin="4,12,4,4">
                                <Button Content="Pair Source Agent" Command="{Binding PairSourceCommand}" HorizontalAlignment="Left" ToolTip="Create a one-time 10-minute pairing code and pinned Storage certificate fingerprint." AutomationProperties.AutomationId="PairSourceButton"/>
                                <TextBlock Text="Backup sets are synchronized from paired Source Agents." TextWrapping="Wrap" Foreground="#607086" Margin="4,4"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="Backup targets" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AutomationProperties.AutomationId="MappingsGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Source / Backup set" Binding="{Binding BackupSetName}" Width="2*"/>
                                    <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="*"/>
                                    <DataGridTextColumn Header="Destination folder" Binding="{Binding DestinationFolder}" Width="2*"/>
                                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, Mode=OneWay}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="Backup set" Margin="6,0" Foreground="#607086"/><ComboBox ItemsSource="{Binding BackupSets}" SelectedItem="{Binding SelectedBackupSet}" DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="BackupSetCombo"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Device" Margin="6,0" Foreground="#607086"/><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="MappingDeviceCombo"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Destination folder" Margin="6,0" Foreground="#607086"/><DockPanel><Button Content="Browse…" Command="{Binding BrowseDestinationCommand}" DockPanel.Dock="Right" Margin="6,0,0,0" AutomationProperties.AutomationId="BrowseDestinationButton"/><TextBox Text="{Binding NewDestinationFolder, UpdateSourceTrigger=PropertyChanged}" ToolTip="Folder on the selected device" AutomationProperties.AutomationId="DestinationFolderInput"/></DockPanel></StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Remove selected" Command="{Binding RemoveMappingCommand}" AutomationProperties.AutomationId="RemoveMappingButton"/>
                                    <Button Content="Add mapping" Command="{Binding AddMappingCommand}" Background="{StaticResource AccentBrush}" Foreground="White" AutomationProperties.AutomationId="AddMappingButton"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Devices" AutomationProperties.AutomationId="DevicesTab">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AutomationProperties.AutomationId="RegisteredDevicesGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device" Binding="{Binding DisplayName}" Width="2*"/>
                            <DataGridTextColumn Header="Volume" Binding="{Binding VolumeLabel}" Width="*"/>
                            <DataGridTextColumn Header="Current location" Binding="{Binding CurrentRoot}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                            <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenDisplay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="360" ItemsSource="{Binding AvailableDrives}" SelectedItem="{Binding SelectedAvailableDrive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="AvailableDrivesCombo"/>
                            <Button Content="Refresh drives" Command="{Binding RefreshDrivesCommand}" AutomationProperties.AutomationId="RefreshDrivesButton"/>
                            <Button Content="Register selected device" Command="{Binding RegisterDeviceCommand}" AutomationProperties.AutomationId="RegisterDeviceButton"/>
                            <Button Content="Register folder…" Command="{Binding RegisterFolderCommand}" ToolTip="Use a local or network folder as a logical storage device." AutomationProperties.AutomationId="RegisterFolderButton"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Forget selected device" Command="{Binding ForgetDeviceCommand}" AutomationProperties.AutomationId="ForgetDeviceButton"/>
                            <Button Content="Safely remove selected device" Command="{Binding EjectDeviceCommand}" AutomationProperties.AutomationId="EjectDeviceButton"/>
                            <TextBlock Text="Selected device arrival delay" Margin="18,0,6,0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SelectedDevice.ArrivalDelayMinutes}" Width="55" AutomationProperties.AutomationId="ArrivalDelayInput"/>
                            <TextBlock Text="minutes" VerticalAlignment="Center" Margin="5,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Settings" AutomationProperties.AutomationId="SettingsTab">
                <StackPanel Margin="24" MaxWidth="650" HorizontalAlignment="Left">
                    <TextBlock Text="Automation" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <CheckBox Content="Start BackupMesh when I sign in" IsChecked="{Binding StartWithWindows}" Margin="4,8" AutomationProperties.AutomationId="StartWithWindowsCheckBox"/>
                    <CheckBox Content="Show a Windows notification when a registered device is connected" IsChecked="{Binding NotifyOnDeviceArrival}" Margin="4,8" AutomationProperties.AutomationId="NotifyOnDeviceArrivalCheckBox"/>
                    <CheckBox Content="Automatically start eligible backups after the grace period" IsChecked="{Binding AutomaticBackups}" Margin="4,8" AutomationProperties.AutomationId="AutomaticBackupsCheckBox"/>
                    <Separator Margin="0,18"/>
                    <TextBlock Text="Data location" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Choose a destination folder for every backup target. BackupMesh internally keeps the folder relative to its registered device so removable-drive letter changes do not break mappings. Fixed drives, removable storage, and registered local or network folders are supported." TextWrapping="Wrap" Foreground="#526276"/>
                    <Button Content="Save settings" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,18,0,0" AutomationProperties.AutomationId="SaveSettingsButton"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#E8EDF4" Padding="12,6"><TextBlock Text="{Binding FooterStatus}" Foreground="#44566C" AutomationProperties.AutomationId="FooterStatusText"/></Border>
    </Grid>
</Window>
