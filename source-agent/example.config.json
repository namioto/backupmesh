{
  "agent": {
    "name": "Example source"
  },
  "storage": {
    "repositoryPasswordFile": "/etc/backupmesh/restic-password"
  },
  "uploadLimitBps": 10485760,
  "backupSets": [
    {
      "name": "documents",
      "paths": ["/home/example/Documents"],
      "exclude": ["**/.cache/**"],
      "hooks": {
        "before": [["/usr/local/bin/prepare-backup", "documents"]]
      }
    }
  ]
}
